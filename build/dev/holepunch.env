#
# xDS Control Panel
HOLEPUNCH_ENABLE_WEBSOCKET=true

#
# Storage
HOLEPUNCH_STORAGE_HOST=nats://nats:4222

#
# Route Registry
HOLEPUNCH_REGISTRY_HOST=http://mock-api:9001
HOLEPUNCH_ROUTE_PATH=/route-registry/routes
HOLEPUNCH_STATIC_CONFIG=/etc/holepunch/static.yaml

#
# Token Service
HOLEPUNCH_OAUTH_EXCHANGE_PATH=/token-service/token/oauth
HOLEPUNCH_SUBTOKEN_PATH=/token-service/admin/token
HOLEPUNCH_TOKEN_EXCHANGE_PATH=/token-service/token/jwt
HOLEPUNCH_TOKEN_HOST=http://mock-api:9001
HOLEPUNCH_TOKEN_HEADER_DEBUG=true
HOLEPUNCH_DEV_HOST_HEADER=:authority

#
# Oauth Management (oauth2-proxy-middleware strategy, auth domain served through Envoy)
HOLEPUNCH_OAUTH_STRATEGY=oauth2-proxy-middleware
HOLEPUNCH_OAUTH2_PROXY_INTERNAL=http://oauth2-proxy:4180
HOLEPUNCH_OAUTH_USER_AUTH_URL=auth.holepunch.localwormhole:3128
HOLEPUNCH_OAUTH_PROXY_COOKIE_NAME=_oauth2_proxy
# Must match oauth2-proxy's session_store_type (oauth2-proxy.cfg).
HOLEPUNCH_OAUTH_PROXY_SESSION_STORE=redis
HOLEPUNCH_OAUTH_LEDGER_URL=http://holepunch-oauthmngr:8083

#
# Global
HOLEPUNCH_DEVELOPMENT=true
