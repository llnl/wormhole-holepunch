ARG GO_VERSION
FROM docker.io/library/golang:${GO_VERSION} AS build

WORKDIR /holepunch
COPY  . .

# Limit to avoid resource issues when building.
ARG GOMAXPROCS=4
ARG VERSION

RUN make build && \
    ./binaries/holepunch --version

FROM gcr.io/distroless/static-debian13:latest-amd64

COPY --from=build /holepunch/binaries/holepunch /holepunch

ENTRYPOINT ["/holepunch"]
