ARG GO_VERSION=latest
FROM docker.io/library/golang:${GO_VERSION} AS build

WORKDIR /holepunch
COPY  . .

# Limit to avoid resource issues when building.
ARG GOMAXPROCS=4
ARG VERSION

# The Holepunch binary and every proxy-wasm plugin are built from the same source, keeping
# plugin versions locked to the control plane that generates their configuration.
RUN make build build-wasm && \
    ./binaries/holepunch --version

# Holepunch (default target).
FROM gcr.io/distroless/static-debian13:latest-amd64 AS holepunch

COPY --from=build /holepunch/binaries/holepunch /holepunch
COPY --from=build /holepunch/binaries/*.wasm /plugin/

ENTRYPOINT ["/holepunch"]
