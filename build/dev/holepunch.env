#
# xDS Control Panel
HOLEPUNCH_ENABLE_WEBSOCKET=true

#
# Storage
HOLEPUNCH_NATS_HOST=nats://nats:4222

#
# Route Registry
HOLEPUNCH_REGISTRY_HOST=http://mock-api:9001
HOLEPUNCH_ROUTE_PATH=/route-registry/routes

#
# Token Service
HOLEPUNCH_OAUTH_EXCHANGE_PATH=/token-service/token/oauth
HOLEPUNCH_OAUTH_PROXY=http://oauth.holepunch.localwormhole:4180
HOLEPUNCH_SUBTOKEN_PATH=/token-service/admin/token
HOLEPUNCH_TOKEN_COOKIES=_wormhole_holepunch_test
HOLEPUNCH_TOKEN_EXCHANGE_PATH=/token-service/token/jwt
HOLEPUNCH_TOKEN_HEADER_DEBUG=true
HOLEPUNCH_TOKEN_HOST=http://mock-api:9001
